+test "parallel output hashing validates odd-length blobs before either restore path writes" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const cwd = try Dir.cwd().realPathFileAlloc(io, try std.fs.path.join(a, &.{ ".zig-cache", "tmp", &tmp.sub_path }), a);
+    var env = std.process.Environ.Map.init(a);
+    try env.put("NANOCOMPILE_BLOB_HASH_MODE", "2");
+    var ctx: Context = .{ .a = a, .io = io, .env = &env, .root = try std.fs.path.join(a, &.{ cwd, "cache" }), .cwd = cwd };
+    try ctx.prepare();
+    var records: std.ArrayList(Dependency) = .empty;
+    for (0..32) |i| {
+        const name = try std.fmt.allocPrint(a, "input-{d}", .{i});
+        try tmp.dir.writeFile(io, .{ .sub_path = name, .data = name });
+        const path = try std.fs.path.join(a, &.{ cwd, name });
+        try records.append(a, .{ .path = path, .hash = try ctx.digest(path) });
+    }
+    const bytes = try a.alloc(u8, 32 * 1024 * 1024 + 137);
+    for (bytes, 0..) |*byte, i| byte.* = @intCast(i % 251);
+    const output = try std.fs.path.join(a, &.{ cwd, "output" });
+    const key = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789";
+    for ([_]usize{ 1, 32 }) |count| {
+        try tmp.dir.writeFile(io, .{ .sub_path = "output", .data = bytes });
+        const expected = try ctx.digest(output);
+        try std.testing.expectEqualStrings(expected, try ctx.digestBlob(output));
+        try store(&ctx, key, records.items[0..count], &.{output}, "", "");
+        try tmp.dir.deleteFile(io, "output");
+        try std.testing.expect(try restore(&ctx, key, &.{output}));
+        try std.testing.expectEqualStrings(expected, try ctx.digest(output));
+        const blob = try blobPath(&ctx, expected);
+        const before = try Dir.cwd().statFile(io, blob, .{});
+        bytes[bytes.len - 1] ^= 1;
+        try ctx.atomic(blob, bytes);
+        const changed = try Dir.cwd().openFile(io, blob, .{});
+        try changed.setTimestamps(io, .{ .modify_timestamp = .{ .new = before.mtime } });
+        changed.close(io);
+        try tmp.dir.writeFile(io, .{ .sub_path = "output", .data = "untouched" });
+        try std.testing.expect(!try restore(&ctx, key, &.{output}));
+        try std.testing.expectEqualStrings("untouched", try ctx.read(output));
+        bytes[bytes.len - 1] ^= 1;
+        try ctx.atomic(blob, bytes);
+        try std.testing.expect(try restore(&ctx, key, &.{output}));
+        try std.testing.expectEqualStrings(expected, try ctx.digest(output));
+    }

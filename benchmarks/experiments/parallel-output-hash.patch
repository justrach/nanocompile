+    // Experimental output-only hashing. The default path is unchanged.
+    // Modes 1 and 2 use the same bounded owned snapshot; mode 2 adds at most
+    // three pool workers to its calling output-validation thread.
+    pub fn digestBlob(self: *Context, path_: []const u8) ![]const u8 {
+        const mode = self.env.get("NANOCOMPILE_BLOB_HASH_MODE") orelse "0";
+        const parallel = std.mem.eql(u8, mode, "2");
+        if (!parallel and !std.mem.eql(u8, mode, "1")) return self.digest(path_);
+        const file = try Dir.cwd().openFile(self.io, path_, .{});
+        defer file.close(self.io);
+        const before = try file.stat(self.io);
+        if (before.kind != .file) return error.NotRegularFile;
+        if (before.size < 32 * 1024 * 1024 or before.size > 256 * 1024 * 1024)
+            return self.digest(path_);
+        const a = std.heap.page_allocator;
+        const bytes = try a.alloc(u8, @intCast(before.size + 1));
+        defer a.free(bytes);
+        var reader = file.reader(self.io, &.{});
+        const n = try reader.interface.readSliceShort(bytes);
+        if (n != before.size or !sameFileState(before, try file.stat(self.io)) or
+            !sameFileState(before, try Dir.cwd().statFile(self.io, path_, .{})))
+            return error.InputChangedDuringHashing;
+        var result: [Hash.digest_length]u8 = undefined;
+        if (parallel) {
+            var threaded = std.Io.Threaded.init(a, .{
+                .async_limit = .limited(3),
+                .concurrent_limit = .limited(3),
+            });
+            defer threaded.deinit();
+            try Hash.hashParallel(bytes[0..n], &result, .{}, a, threaded.io());
+            self.trace("hash: parallel output blob snapshot");
+        } else {
+            Hash.hash(bytes[0..n], &result, .{});
+            self.trace("hash: serial output blob snapshot");
+        }
+        return self.a.dupe(u8, &std.fmt.bytesToHex(result, .lower));
+    }

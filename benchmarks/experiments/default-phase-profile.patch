@@ -0,0 +1,10 @@
+const std = @import("std");
+const cache = @import("cache.zig");
+extern "c" fn getpid() c_int;
+pub fn now(ctx: *cache.Context) i96 { return std.Io.Clock.awake.now(ctx.io).nanoseconds; }
+pub fn emit(ctx: *cache.Context, label: []const u8, key: []const u8, data: anytype) void {
+    const body = std.json.Stringify.valueAlloc(ctx.a, .{ .label = label, .key = key, .crate = ctx.env.get("CARGO_CRATE_NAME"), .data = data }, .{}) catch return;
+    const name = std.fmt.allocPrint(ctx.a, "{d}-{d}.json", .{ getpid(), now(ctx) }) catch return;
+    const file = ctx.path(&.{ "default-phase", name }) catch return;
+    ctx.atomic(file, body) catch {};
+}

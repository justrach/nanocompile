+const DigestJob = struct { expected: Stamp, hash: [64]u8 = undefined, valid: bool = false };
+fn digestWorker(ctx: *const cache.Context, jobs: []DigestJob, next: *std.atomic.Value(usize)) void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+    var local = ctx.*;
+    local.a = arena.allocator();
+    while (true) {
+        const index = next.fetchAdd(1, .monotonic);
+        if (index >= jobs.len) return;
+        const hash = rustFileDigest(&local, jobs[index].expected) catch continue;
+        @memcpy(&jobs[index].hash, hash);
+        jobs[index].valid = true;
+    }
+}
+
+fn rustDigests(ctx: *cache.Context, stamps: []const Stamp) !?[]DigestJob {
+    var count: usize = 0;
+    var size: u64 = 0;
+    for (stamps) |s| if (s.exists and s.kind == .file) {
+        count += 1;
+        size +|= s.size;
+    };
+    if (count < 8 or size < 64 * 1024 * 1024) return null;
+    const jobs = try ctx.a.alloc(DigestJob, count);
+    var index: usize = 0;
+    for (stamps) |s| if (s.exists and s.kind == .file) {
+        jobs[index] = .{ .expected = s };
+        index += 1;
+    };
+    var next = std.atomic.Value(usize).init(0);
+    var group: std.Io.Group = .init;
+    defer group.cancel(ctx.io);
+    for (0..3) |_| group.concurrent(ctx.io, digestWorker, .{ ctx, jobs, &next }) catch break;
+    digestWorker(ctx, jobs, &next);
+    try group.await(ctx.io);
+    for (jobs) |job| if (!job.valid) return error.ToolchainDigestFailed;
+    return jobs;
+}

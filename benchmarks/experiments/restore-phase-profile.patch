+fn restorePhase(ctx: *Context, previous: *i96, phase: []const u8) void {
+    if (!std.mem.eql(u8, ctx.env.get("NANOCOMPILE_PROFILE_PRODUCER") orelse "", "1")) return;
+    const now = std.Io.Clock.awake.now(ctx.io).nanoseconds;
+    std.debug.print("nanocompile: profile restore {s} {d} ns\n", .{ phase, now - previous.* });
+    previous.* = now;
+}

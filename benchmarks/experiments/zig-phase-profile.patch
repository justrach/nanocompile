--- a/src/zig_profile.zig
+++ b/src/zig_profile.zig
@@ -0,0 +1,9 @@
+const std = @import("std");
+const cache = @import("cache.zig");
+pub fn now(ctx: *cache.Context) i96 { return std.Io.Clock.awake.now(ctx.io).nanoseconds; }
+pub fn emit(ctx: *cache.Context, label: []const u8, data: anytype) void {
+    if (ctx.env.get("NANOCOMPILE_ZIG_PROFILE") == null) return;
+    const bytes = std.json.Stringify.valueAlloc(ctx.a, .{ .label = label, .data = data }, .{}) catch return;
+    const filename = std.fmt.allocPrint(ctx.a, "{s}/{s}-{d}-{d}.json", .{ctx.root, label, std.c.getpid(), now(ctx)}) catch return;
+    ctx.atomic(filename, bytes) catch {};
+}

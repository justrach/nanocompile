+++ b/src/cold_profile.zig
@@ -0,0 +1,11 @@
+const std = @import("std");
+const cache = @import("cache.zig");
+extern "c" fn getpid() c_int;
+fn pid() c_int { return getpid(); }
+pub fn now(ctx: *cache.Context) i96 { return std.Io.Clock.awake.now(ctx.io).nanoseconds; }
+pub fn emit(ctx: *cache.Context, label: []const u8, data: anytype) void {
+    if (ctx.env.get("NANOCOMPILE_MISS_PROFILE") == null) return;
+    const body = std.json.Stringify.valueAlloc(ctx.a, .{ .label = label, .crate = ctx.env.get("CARGO_CRATE_NAME"), .data = data }, .{}) catch return;
+    const file = ctx.path(&.{ "cold-profile", std.fmt.allocPrint(ctx.a, "{s}-{d}-{d}.json", .{ label, pid(), now(ctx) }) catch return }) catch return;
+    ctx.atomic(file, body) catch {};
+}

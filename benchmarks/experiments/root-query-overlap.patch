+// Separate allocator: the calling context arena is not threadsafe.
+const LiveSysrootQuery = struct {
+    result: ?std.process.RunResult = null,
+    failure: ?anyerror = null,
+    fn run(self: *LiveSysrootQuery, io: std.Io, argv: []const []const u8, env: *const std.process.Environ.Map) void {
+        self.result = std.process.run(std.heap.page_allocator, io, .{ .argv = argv, .environ_map = env }) catch |err| {
+            self.failure = err;
+            return;
+        };
+    }
+    fn raw(self: *const LiveSysrootQuery) !std.process.RunResult {
+        if (self.failure) |err| return err;
+        return self.result orelse error.RustSysrootQueryFailed;
+    }
+    fn deinit(self: *LiveSysrootQuery) void {
+        if (self.result) |result| {
+            std.heap.page_allocator.free(result.stdout);
+            std.heap.page_allocator.free(result.stderr);
+        }
+    }
+};

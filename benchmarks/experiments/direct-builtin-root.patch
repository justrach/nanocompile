+fn directRoot(ctx: *cache.Context, path: []const u8) !?Root {
+    if (!std.mem.endsWith(u8, path, ".rmeta")) return null;
+    const bytes = ctx.read(path) catch return null;
+    const graph = @import("rmeta_direct.zig").decode(ctx.a, bytes) catch return null;
+    ctx.trace("metadata: direct toolchain root");
+    return .{ .name = graph.root.name, .hash = graph.root.hash, .triple = graph.root.triple, .proc_macro = graph.root.proc_macro };
